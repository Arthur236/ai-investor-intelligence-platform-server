# Anthropic (chat + structured KPI extraction)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Voyage AI (embeddings)
VOYAGE_API_KEY=""
VOYAGE_MODEL="voyage-3"

# Astra DB (vector store)
ASTRA_DB_API_ENDPOINT=""
ASTRA_DB_APPLICATION_TOKEN=""
ASTRA_DB_KEYSPACE="default_keyspace"
ASTRA_DB_COLLECTION="financial_documents"

# Postgres (KPI storage)
POSTGRES_HOST=""
POSTGRES_PORT=""
POSTGRES_DATABASE=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
# "require" for managed/cloud Postgres (default); set to "disable" for local Postgres without SSL
POSTGRES_SSLMODE="require"

# API
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
